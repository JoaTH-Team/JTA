-L lime
-L openfl
-L flixel
-L flixel-addons
-L extension-webm
-L hscript
-L polymod
-L firetongue
-L hxgamemode
-L hxdiscord_rpc
-L hxWindowColorMode
-L sl-windows-api
-L jsonpath
-L jsonpatch
-L thx.core
-L thx.semver
-L extension-androidtools
-L extension-videoview
-L ios-videoplay

-D windows

-cp source

--define hscriptPos
--define NO_REDIRECT_ASSETS_FOLDER
--define FLX_NO_HEALTH
--define FLX_NO_DEBUG

--macro lime._internal.macros.DefineMacro.run()
--macro openfl.utils._internal.ExtraParamsMacro.include()
--remap flash:openfl
--macro flixel.system.macros.FlxDefines.run()

--define doc-gen
--define message.reporting=pretty
--define no-deprecation-warnings

--macro addMetadata('@:build(jta.util.macro.FlxMacro.buildFlxBasic())', 'flixel.FlxBasic')
--macro include('jta.objects')
--macro include('jta')
--macro nullSafety('jta.registries')
--macro nullSafety('jta.util')
--macro keep('Main')

--no-output

-xml docs/doc.xml
--cpp docs-bin/

-dce no