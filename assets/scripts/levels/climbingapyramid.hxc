import jta.states.level.Level;
import jta.shaders.RuntimeShader;
import flixel.FlxG;

class ClimbingAPyramidLevel extends Level
{
	var shader:RuntimeShader;

	public function new():Void
	{
		super('world3/lev3');
	}

	public override function create():Void
	{
		super.create();

		shader = new RuntimeShader('heatwave');

		FlxG.camera.filters = [shader.toFilter()];
	}

	public override function update(elapsed:Float):Void
	{
		super.update(elapsed);

		if (shader != null)
			shader.update(elapsed);
	}
}
