import jta.Paths;
import jta.audio.SoundController;
import jta.objects.level.Object;
import flixel.FlxG;

class TrampolineObject extends Object
{
	public function new():Void
	{
		super('trampoline');

		objectInteractable = true;

		loadGraphic(Paths.image('objects/' + objectID));

		immovable = true;
		solid = true;
	}

	public override function overlap():Void
	{
		if (FlxG.state.player != null && FlxG.state.player.velocity.y >= 0)
		{
			SoundController.play(Paths.sound('boing'));
			FlxG.state.player.velocity.y = -300;
		}
	}
}
