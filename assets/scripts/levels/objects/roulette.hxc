import jta.Paths;
import jta.Global;
import jta.audio.SoundController;
import jta.objects.level.Object;
import flixel.FlxG;

class RouletteObject extends Object
{
	var locked:Bool = false;

	public function new():Void
	{
		super('roulette');

		objectInteractable = true;

		loadGraphic(Paths.image('objects/' + objectID), true, 16, 16);
		animation.add('random', [0, 1, 2, 3], 12, true);
		animation.play('random');

		immovable = true;
		solid = false;
	}

	public override function overlap():Void
	{
		if (locked)
			return;

		locked = true;
		objectInteractable = false;
		animation.curAnim.stop();

		FlxG.state.startWinSequence();

		SoundController.play(Paths.sound('coin'));

		switch (animation.curAnim.curFrame)
		{
			case 0:
				Global.score += 100;
				SoundController.play(Paths.sound('win'));
			case 1:
				Global.score += 300;
				SoundController.play(Paths.sound('win'));
			case 2:
				Global.score += 500;
				SoundController.play(Paths.sound('win'));
			case 3:
				Global.lives += 1;
				SoundController.play(Paths.sound('life'));
		}
		Global.save();
	}
}
