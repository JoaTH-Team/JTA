import jta.Paths;
import jta.Global;
import jta.audio.SoundController;
import jta.objects.level.Object;
import jta.substates.LevelComplete;
import jta.states.LevelSelect;
import jta.states.DemoEnd;
import jta.video.VideoState;
import flixel.util.FlxTimer;
import flixel.FlxG;

class FlagObject extends Object
{
	public function new():Void
	{
		super('flag');

		objectInteractable = true;

		loadGraphic(Paths.image('objects/' + objectID), true, 14, 16);

		animation.add('wave', [1, 2, 3, 4, 0], 12, true);
		animation.play('wave');

		immovable = true;
		solid = false;
	}

	public override function overlap():Void
	{
		if (FlxG.sound.music != null)
			FlxG.sound.music.stop();
		SoundController.play(Paths.sound('win'));
		Global.score += 1000;
		Global.save();

		objectInteractable = false;

		var player = FlxG.state.player;
		if (player != null)
		{
			player.characterControllable = false;
			player.animation.play('dance');
			player.velocity.x = 0;
		}

		new FlxTimer().start(3, function(tmr:FlxTimer):Void
		{
			FlxG.state.persistentUpdate = false;
			FlxG.state.openSubState(new LevelComplete(function():Void 
			{
				if (FlxG.state.baseLevel)
				{
					Global.flags[FlxG.state.levelNumber - 1] = 1;
					Global.save();
					if (FlxG.state.levelNumber == 3)
					{
						FlxG.switchState(new VideoState('endCutscenes/world1', true, function():Void
						{
							FlxG.switchState(new DemoEnd('default', true));
						}));
						return;
					}
				}
				
				FlxG.switchState(new LevelSelect());
			}));
		});
	}
}
