import jta.Paths;
import jta.Global;
import jta.audio.SoundController;
import jta.objects.level.Object;
import flixel.FlxG;

class FlagObject extends Object
{
	public function new():Void
	{
		super('flag');

		objectInteractable = true;

		loadGraphic(Paths.image('objects/' + objectID), true, 14, 16);

		animation.add('wave', [1, 2, 3, 4, 0], 12, true);
		animation.play('wave');

		immovable = true;
		solid = false;
	}

	public override function overlap():Void
	{
		objectInteractable = false;

		FlxG.state.startWinSequence();

		SoundController.play(Paths.sound('win'));
		Global.score += 1000;
		Global.save();
	}
}
